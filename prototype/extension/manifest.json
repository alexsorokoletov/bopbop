{
  "manifest_version": 3,
  "name": "bopbop relay",
  "version": "0.1.0",
  "description": "Your AI agent (Claude Code, Codex, Cursor) works in your real Chrome, in its own tab group. Your tabs stay yours. Local, no cloud.",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "scripting", "nativeMessaging", "downloads"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "bopbop",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "host_permissions": ["<all_urls>"]
}
